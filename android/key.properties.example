# Copy this file to "key.properties" (same folder) and fill the values.
# IMPORTANT: Do NOT commit your real key.properties or keystore.

# If your keystore file is placed in the android/ folder, this can be just "upload-keystore.jks"
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
